#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.0cm, minimum width=3.6cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    store/.style={draw=navy, fill=white, cylinder, shape border rotate=90, aspect=0.18,
                  align=center, minimum height=1.0cm, minimum width=3.4cm, inner sep=4pt},
    server/.style={draw=navy, fill=white, rounded corners=3pt, align=center,
                   minimum width=2.4cm, inner sep=5pt},
    lane/.style={font=\footnotesize\bfseries, text=navy, anchor=west},
    step/.style={font=\footnotesize\bfseries, text=azureblue, inner sep=2pt},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt, align=center},
    wire/.style={->, draw=navy},
  ]

  % ---------- shared stores (middle row) ----------
  \node[store] (cfg) at (4.6,0) {\verb|~/.gitconfig|};
  \node[store] (kc)  at (10.4,0) {macOS Keychain};

  % ---------- once: setup commands (top row) ----------
  \node[block] (setup) at (4.6,2.6) {\texttt{gh auth setup-git}};
  \node[block] (login) at (10.4,2.6) {\texttt{gh auth login}};

  % ---------- every push: git and gh (bottom row) ----------
  \node[block, minimum width=2.4cm] (git) at (0,-2.8) {\texttt{git push}};
  \node[accent, minimum width=4.2cm] (helper) at (10.4,-2.8) {\texttt{gh auth git-credential}};

  % ---------- server ----------
  \node[server, minimum height=6.6cm] (srv) at (15.6,0) {\texttt{github.com}};

  % ---------- once ----------
  \draw[wire] (setup) -- node[sig, right] {adds \texttt{credential.helper}\\for \texttt{https://github.com}} (cfg);
  \draw[wire] (login) -- node[sig, right] {stores the\\OAuth token} (kc);
  \draw[<->, draw=navy] (login) -- node[sig, above] {browser OAuth} (login -| srv.west);

  % ---------- every push ----------
  \draw[wire] (git.north) |- node[step, pos=0.25, left] {1} node[sig, pos=0.75, above] {which helper for\\\texttt{https://github.com}?} (cfg.west);
  \draw[wire] ([yshift=2mm]git.east) -- node[step, pos=0.1, above] {2}
        node[sig, above] {\texttt{get}\quad\texttt{protocol=https}, \texttt{host=github.com}} ([yshift=2mm]helper.west);
  \draw[wire] (helper) -- node[step, pos=0.4, left] {3} node[sig, pos=0.4, right] {read token} (kc);
  \draw[wire] ([yshift=-2mm]helper.west) -- node[step, pos=0.9, below] {4}
        node[sig, below] {\texttt{username=<login>}, \texttt{password=gho\_...}} ([yshift=-2mm]git.east);

  \coordinate (low) at ($(git.south)+(0,-0.9)$);
  \draw[wire] (git.south) -- (low) -- node[step, pos=0.06, above] {5}
        node[sig, above, pos=0.5] {HTTPS request with the token} (low -| srv.south) -- (srv.south);

  % ---------- lanes ----------
  \coordinate (sep) at ($(cfg.south)!0.5!(helper.north)+(0,0.15)$);
  \coordinate (lane-x) at ($(git.center)+(0.25,0)$);
  \node[lane] at (lane-x |- setup) {Once};
  \node[lane] at ($(lane-x |- sep)+(0,-0.35)$) {Every push / fetch};
  \draw[lightgray, dashed] (git.west |- sep) -- ($(sep -| srv.west)+(-0.3,0)$);

\end{tikzpicture}
